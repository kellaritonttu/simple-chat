FROM node:24-slim AS build

WORKDIR /app

# Copy dependency files first to use Docker cache
COPY package*.json ./
RUN npm install

# Copy code and run the static build
COPY . .
RUN npm run build

FROM nginx:alpine
# Copy the static output generated by adapter-static
COPY --from=build /app/build /usr/share/nginx/html
# Copy into templates directory for automatic envsubst replacement
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["/bin/sh", "-c", "/docker-entrypoint.sh nginx -g 'daemon off;' & sleep 3 && cat /etc/nginx/conf.d/default.conf && wait"]