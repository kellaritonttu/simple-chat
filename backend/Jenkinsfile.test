@Library('shared') _

pipeline {
    agent any

    stages {
        
        stage('Cleanup') {
            steps {
                deleteDir()
            }
        }
        
        stage('Checkout') {
            steps {
                checkout scm
            }
        }        

        stage('Test backend') {
            steps {
                runTests(
                    workDir:     'backend',
                    composeFile: 'docker-compose.test.yaml'
                )       
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}