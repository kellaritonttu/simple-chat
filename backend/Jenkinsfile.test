pipeline {
    agent any

    stages {
        
        stage('Checkout') {
            steps {
                checkout scm
            }
        }        

        stage('Test backend') {
            steps {
                sh '''
                    cd ./backend
                    docker-compose -f docker-compose.test.yaml up --build --abort-on-container-exit
                '''
            }
        }
    }

    post {
        always {
            // Cleanup
            sh '''
                cd ./backend
                docker-compose -f docker-compose.test.yml down -v || true
            '''
            cleanWs()
        }
    }
}